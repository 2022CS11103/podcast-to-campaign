# Optional. Same bind as proxy.js: 127.0.0.1:8000
# No npm install required.

PORT=8000
HOST=127.0.0.1

# Live site
PUBLIC_URL=https://creatoros.acmebiz.us

# Public studio URL in the browser. Relative /app/?mode=signup loops if nginx
# still sends /app to this process (port 8000). Prefer the full public URL.
STUDIO_URL=https://creatoros.acmebiz.us/app/?mode=signup

# FastAPI behind the landing process. Landing proxies /app and API calls here.
STUDIO_BACKEND=http://127.0.0.1:8002

# FastAPI public origin (OAuth / billing redirects)
# FRONTEND_URL=https://creatoros.acmebiz.us/app

# Secret key (sk_...) or restricted key (rk_...). Restricted keys need:
#   Checkout Sessions: Write
#   Customers: Write
#   Products: Write
#   Prices: Write
# Publishable keys (pk_...) will not work.
# Stripe keys kept for later — checkout API returns 503 while paywall is off.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_TRIAL_DAYS=7
