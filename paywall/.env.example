# Optional. Same bind as proxy.js: 127.0.0.1:8000
# No npm install required.

PORT=8000
HOST=127.0.0.1
# Live site
PUBLIC_URL=https://creatoros.acmebiz.us

# Studio signup entry for “Try free demo” / “Open studio”
# Same-origin path works when paywall serves frontend/dist under /app/
STUDIO_URL=/app/?mode=signup

# FastAPI backend used for API proxy (uploads, process, accounts, …)
STUDIO_BACKEND=http://127.0.0.1:8002

# Live absolute override (optional):
# STUDIO_URL=https://creatoros.acmebiz.us/app/?mode=signup

# Local override example if studio is on another port only:
# STUDIO_URL=http://127.0.0.1:8002/app/?mode=signup

# Stripe keys kept for later — checkout API returns 503 while paywall is off.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_TRIAL_DAYS=7