# Optional. Same bind as proxy.js: 127.0.0.1:8000
# No npm install required.

PORT=8000
HOST=127.0.0.1
PUBLIC_URL=https://creatoros.acmebiz.us

# Required for Checkout. Payment Links below can replace this if you prefer.
STRIPE_SECRET_KEY=sk_test_...

# Optional: 7-day trial on every new subscription (0 to disable)
STRIPE_TRIAL_DAYS=7

# Optional: use existing Stripe Price IDs instead of creating prices at checkout
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_CREATOR_MONTHLY=price_...
# STRIPE_PRICE_CREATOR_YEARLY=price_...
# STRIPE_PRICE_STUDIO_MONTHLY=price_...
# STRIPE_PRICE_STUDIO_YEARLY=price_...

# Optional: skip the API and send the buyer straight to a Stripe Payment Link
# STRIPE_LINK_STARTER_MONTHLY=https://buy.stripe.com/...
# STRIPE_LINK_STARTER_YEARLY=https://buy.stripe.com/...
# STRIPE_LINK_CREATOR_MONTHLY=https://buy.stripe.com/...
# STRIPE_LINK_CREATOR_YEARLY=https://buy.stripe.com/...
# STRIPE_LINK_STUDIO_MONTHLY=https://buy.stripe.com/...
# STRIPE_LINK_STUDIO_YEARLY=https://buy.stripe.com/...
